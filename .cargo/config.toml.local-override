cranpose-runtime-std = { path = "/Users/s/develop/projects/Cranpose/crates/cranpose-runtime-std" }
cranpose-services = { path = "/Users/s/develop/projects/Cranpose/crates/cranpose-services" }
cranpose-ui = { path = "/Users/s/develop/projects/Cranpose/crates/cranpose-ui" }
